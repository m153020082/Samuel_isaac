#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Foot_assembly_13"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Foot_assembly_13" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Foot_assembly_13/Physics/root_joint>,
        </Foot_assembly_13/Physics/link1>,
        </Foot_assembly_13/Physics/link2>,
        </Foot_assembly_13/Physics/feet>,
        </Foot_assembly_13/Physics/revolving>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Foot_assembly_13/Geometry/base_link>,
        </Foot_assembly_13/Geometry/base_link/link1>,
        </Foot_assembly_13/Geometry/base_link/link1/feet>,
        </Foot_assembly_13/Geometry/base_link/link2>,
        </Foot_assembly_13/Geometry/base_link/link2/tn__link21_m9>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "feet" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "link2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "tn__link21_m9" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "link1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "feet" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "link2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolving" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

