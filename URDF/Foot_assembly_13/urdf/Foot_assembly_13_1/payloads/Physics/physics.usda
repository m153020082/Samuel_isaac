    over "Physics"
    {
        def PhysicsRevoluteJoint "link1" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:velocityLimit = 0
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </Foot_assembly_13/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Foot_assembly_13/Geometry/base_link/link1>
