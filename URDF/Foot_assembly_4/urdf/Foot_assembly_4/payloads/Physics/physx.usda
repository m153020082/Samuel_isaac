#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Foot_assembly_4"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Foot_assembly_4"
{
    over "Physics"
    {
        over "base_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "feet_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "base_joint_2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "revolving_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "feet_joint_2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

