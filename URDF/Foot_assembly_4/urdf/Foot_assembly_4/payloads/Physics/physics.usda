            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 5
            float newton:velocityLimit = 57.29578
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </Foot_assembly_4/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Foot_assembly_4/Geometry/base_link/link_1>
