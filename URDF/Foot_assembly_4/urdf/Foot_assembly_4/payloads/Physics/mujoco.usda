#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Foot_assembly_4"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Foot_assembly_4"
{
    over "Physics"
    {
        over "base_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "feet_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "base_joint_2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "revolving_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "feet_joint_2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "base_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            custom rel mjc:target
            append rel mjc:target = </Foot_assembly_4/Physics/base_joint>
        }

        def MjcActuator "feet_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            append rel mjc:target = </Foot_assembly_4/Physics/feet_joint>
        }

        def MjcActuator "base_joint_2_actuator"
        {
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            custom rel mjc:target
            append rel mjc:target = </Foot_assembly_4/Physics/base_joint_2>
        }

        def MjcActuator "revolving_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            append rel mjc:target = </Foot_assembly_4/Physics/revolving_joint>
        }

        def MjcActuator "feet_joint_2_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            append rel mjc:target = </Foot_assembly_4/Physics/feet_joint_2>
        }
    }
}

