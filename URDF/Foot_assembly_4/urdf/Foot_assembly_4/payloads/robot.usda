#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Foot_assembly_4"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Foot_assembly_4" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Foot_assembly_4/Physics/root_joint>,
        </Foot_assembly_4/Physics/base_joint>,
        </Foot_assembly_4/Physics/base_joint_2>,
        </Foot_assembly_4/Physics/feet_joint>,
        </Foot_assembly_4/Physics/revolving_joint>,
        </Foot_assembly_4/Physics/feet_joint_2>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Foot_assembly_4/Geometry/base_link>,
        </Foot_assembly_4/Geometry/base_link/link_1>,
        </Foot_assembly_4/Geometry/base_link/link_1/feet>,
        </Foot_assembly_4/Geometry/base_link/link_2>,
        </Foot_assembly_4/Geometry/base_link/link_2/tn__link_21_XB>,
        </Foot_assembly_4/Geometry/base_link/link_2/tn__link_21_XB/feet_2>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "feet" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "link_2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "tn__link_21_XB" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "feet_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "feet_2" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }

                        over "feet_2_1" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "feet_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_joint_2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolving_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "feet_joint_2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

