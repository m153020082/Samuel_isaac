#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__Rod_assemblageSLDASM_oU"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__Rod_assemblageSLDASM_oU" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tn__Rod_assemblageSLDASM_oU/Physics/root_joint>,
        </tn__Rod_assemblageSLDASM_oU/Physics/joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tn__Rod_assemblageSLDASM_oU/Geometry/base_link>,
        </tn__Rod_assemblageSLDASM_oU/Geometry/base_link/pivot>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "pivot" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

