#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__Rod_assemblageSLDASM_oU"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tn__Rod_assemblageSLDASM_oU"
{
    over "Physics"
    {
        over "joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "joint_actuator"
        {
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            custom rel mjc:target
            append rel mjc:target = </tn__Rod_assemblageSLDASM_oU/Physics/joint>
        }
    }
}

