#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Foot_assembly"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Foot_assembly" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Foot_assembly/Physics/root_joint>,
        </Foot_assembly/Physics/base_joint>,
        </Foot_assembly/Physics/feet_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Foot_assembly/Geometry/base_link>,
        </Foot_assembly/Geometry/base_link/link>,
        </Foot_assembly/Geometry/base_link/link/feet>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "feet" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "feet_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

