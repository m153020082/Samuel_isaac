#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "leg"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "leg" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </leg/Physics/root_joint>,
        </leg/Physics/left_joint>,
        </leg/Physics/right_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </leg/Geometry/base_link>,
        </leg/Geometry/base_link/left>,
        </leg/Geometry/base_link/right>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "right" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

